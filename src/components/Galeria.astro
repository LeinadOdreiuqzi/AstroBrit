---
import { Image } from "astro:assets";
import type { GalleryItem, GalleryCollection } from "../types";
import { siteConfig } from "../data/siteConfig.ts";

export type { GalleryItem, GalleryCollection };

export interface Props {
  items?: GalleryItem[];
  collections?: GalleryCollection[];
  columns?: number;
  variant?: string;
  layout?: any;
  indices?: any;
  caption?: string | null;
}

const defaultCaption = `Spawn Britannia ${siteConfig.server?.networkName || ""}`.trim();

const {
  items = [],
  collections = [],
  columns = 6,
  variant = collections.length > 0 || items.length === 1 ? "hero" : "mosaic",
  layout = null,
  caption = null,
} = Astro.props;

const uid = "gal-" + Math.random().toString(36).slice(2);
const activeCaption = caption ?? defaultCaption;

// Normalizar las colecciones para el modo carrusel de la antesala
const activeGalleries: GalleryCollection[] =
  collections && collections.length > 0
    ? collections
    : [
        {
          id: "default-gallery",
          title: siteConfig.server?.networkName
            ? `Britannia en ${siteConfig.server.networkName}`
            : "Construcciones de Britannia",
          caption: activeCaption,
          heroImage: (items[0]?.src as any) || "/assets/servi.webp",
          items: items,
          layout: layout,
        },
      ];
---

<section
  class={`gallery gallery--${variant}`}
  aria-label="Galerías de Britannia"
  data-items={JSON.stringify(items)}
  data-uid={uid}
  data-layout={JSON.stringify(layout)}
  data-caption={activeCaption}
>
  {
    variant === "hero" ? (
      Astro.slots.has("hero") ? (
        <slot name="hero" />
      ) : (
        <div class="gallery-hero-carousel" data-uid={uid}>
          <div class="carousel-viewport">
            {activeGalleries.map((gal, idx) => (
              <article
                class={`carousel-slide ${idx === 0 ? "is-active" : ""}`}
                data-index={idx}
                data-id={gal.id}
                data-title={gal.title}
                data-caption={gal.caption}
                data-items={JSON.stringify(gal.items)}
                data-layout={JSON.stringify(gal.layout || layout)}
                tabindex="0"
                role="button"
                aria-label={`Abrir galería: ${gal.title}`}
              >
                <div class="gallery-media">
                  <Image
                    alt={gal.title}
                    width={1200}
                    height={680}
                    loading={idx === 0 ? "eager" : "lazy"}
                    src={(gal.heroImage as any) || "/assets/servi.webp"}
                  />
                </div>
                <div class="gallery-overlay" aria-hidden="true" />

                <div class="hero-caption-inline">
                  {gal.caption || activeCaption}
                </div>
              </article>
            ))}

            <!-- Botones de navegación (Flechas izquierda / derecha) -->
            {activeGalleries.length > 1 && (
              <>
                <button
                  type="button"
                  class="carousel-btn carousel-btn--prev"
                  aria-label="Galería anterior"
                  data-action="prev"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="carousel-btn carousel-btn--next"
                  aria-label="Siguiente galería"
                  data-action="next"
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6" />
                  </svg>
                </button>
              </>
            )}

            <!-- Indicadores inferiores -->
            {activeGalleries.length > 1 && (
              <div class="carousel-indicators" role="tablist" aria-label="Selector de galería">
                {activeGalleries.map((gal, idx) => (
                  <button
                    type="button"
                    role="tab"
                    class={`carousel-dot ${idx === 0 ? "active" : ""}`}
                    data-slide-target={idx}
                    aria-label={`Ir a ${gal.title}`}
                    aria-selected={idx === 0 ? "true" : "false"}
                  />
                ))}
              </div>
            )}
          </div>
        </div>
      )
    ) : (
      <div
        id="gallery-grid"
        class="gallery-grid"
        style={`--columns: ${columns}`}
      >
        <slot />
      </div>
    )
  }
</section>

<script>
  import gsap from "gsap";

  function setupCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>(".gallery-hero-carousel");

    carousels.forEach((carousel) => {
      // Evitar doble inicialización
      if (carousel.dataset.initialized === "true") return;
      carousel.dataset.initialized = "true";

      const viewport = carousel.querySelector<HTMLElement>(".carousel-viewport");
      const slides = Array.from(carousel.querySelectorAll<HTMLElement>(".carousel-slide"));
      const prevBtn = carousel.querySelector<HTMLButtonElement>(".carousel-btn--prev");
      const nextBtn = carousel.querySelector<HTMLButtonElement>(".carousel-btn--next");
      const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>(".carousel-dot"));

      if (!viewport || slides.length === 0) return;

      let currentIndex = 0;
      let isTransitioning = false;

      // Animación inicial del primer slide
      if (slides[0]) {
        gsap.fromTo(
          slides[0],
          { opacity: 0, y: 24 },
          { opacity: 1, y: 0, duration: 0.75, ease: "power3.out" }
        );
      }

      // Función para abrir Lightbox
      const openLightbox = (slideEl: HTMLElement) => {
        const island = document.getElementById("global-lightbox") as any;
        if (!island || !slideEl) return;

        let itemsData = [];
        let slideLayout = null;
        let slideCaption = "";

        try {
          itemsData = JSON.parse(slideEl.dataset.items || "[]");
        } catch {
          itemsData = [];
        }

        try {
          if (slideEl.dataset.layout) {
            slideLayout = JSON.parse(slideEl.dataset.layout);
          }
        } catch {}

        slideCaption = slideEl.dataset.caption || "";

        // Si la galería está vacía temporalmente, no abrimos el lightbox
        if (!itemsData || itemsData.length === 0) {
          return;
        }

        if (typeof island.setData === "function") {
          island.setData({
            mode: "gallery",
            items: itemsData,
            layout: slideLayout,
            caption: slideCaption,
          });
        } else {
          island.setAttribute("mode", "gallery");
          island.setAttribute("items", JSON.stringify(itemsData));
          island.setAttribute("layout", JSON.stringify(slideLayout));
        }

        if (typeof island.open === "function") island.open();
        else island.setAttribute("open", "");
      };

      // Clic en slide para ver galería
      slides.forEach((slide) => {
        slide.addEventListener("click", (e) => {
          if (isTransitioning) return;
          const target = e.target as HTMLElement;
          if (target.closest(".carousel-btn") || target.closest(".carousel-dot")) return;
          openLightbox(slide);
        });

        slide.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openLightbox(slide);
          }
        });
      });

      // Transición cinematográfica entre slides
      const goToSlide = (targetIndex: number, direction: number = 1) => {
        if (isTransitioning || targetIndex === currentIndex || !slides[targetIndex]) return;
        isTransitioning = true;

        const currentSlide = slides[currentIndex];
        const nextSlide = slides[targetIndex];

        // Resetear tilt
        gsap.set([currentSlide, nextSlide], { rotationX: 0, rotationY: 0 });

        // Actualizar el título de la sección si existe en la página
        const sectionTitle = carousel.closest("#galeria")?.querySelector<HTMLElement>(".section-title") || document.querySelector<HTMLElement>("#galeria .section-title");
        if (sectionTitle && nextSlide.dataset.title) {
          gsap.to(sectionTitle, {
            opacity: 0,
            y: -8,
            duration: 0.18,
            onComplete: () => {
              sectionTitle.textContent = nextSlide.dataset.title || "";
              gsap.to(sectionTitle, { opacity: 1, y: 0, duration: 0.28, ease: "power2.out" });
            },
          });
        }

        // Colocar nextSlide encima y preparar visibilidad
        nextSlide.classList.add("is-active");
        gsap.set(nextSlide, { zIndex: 3, visibility: "visible", pointerEvents: "none" });
        gsap.set(currentSlide, { zIndex: 2, pointerEvents: "none" });

        // Salida de slide actual
        gsap.to(currentSlide, {
          xPercent: direction > 0 ? -30 : 30,
          opacity: 0,
          scale: 0.95,
          duration: 0.48,
          ease: "power2.inOut",
        });

        // Entrada del nuevo slide
        gsap.fromTo(
          nextSlide,
          {
            xPercent: direction > 0 ? 35 : -35,
            opacity: 0,
            scale: 1.05,
          },
          {
            xPercent: 0,
            opacity: 1,
            scale: 1,
            duration: 0.54,
            ease: "power3.out",
            onComplete: () => {
              currentSlide.classList.remove("is-active");
              gsap.set(currentSlide, { clearProps: "all" });
              gsap.set(nextSlide, { clearProps: "all" });
              isTransitioning = false;
            },
          }
        );

        // Actualizar dots
        dots.forEach((dot, idx) => {
          const isActive = idx === targetIndex;
          dot.classList.toggle("active", isActive);
          dot.setAttribute("aria-selected", isActive ? "true" : "false");
        });

        currentIndex = targetIndex;
      };

      // Botón Anterior
      prevBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const prev = (currentIndex - 1 + slides.length) % slides.length;
        goToSlide(prev, -1);
      });

      // Botón Siguiente
      nextBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        const next = (currentIndex + 1) % slides.length;
        goToSlide(next, 1);
      });

      // Dots
      dots.forEach((dot) => {
        dot.addEventListener("click", (e) => {
          e.stopPropagation();
          const target = Number(dot.dataset.slideTarget ?? 0);
          if (target !== currentIndex) {
            goToSlide(target, target > currentIndex ? 1 : -1);
          }
        });
      });

      // Gestos Touch / Swipe
      let touchStartX = 0;
      viewport.addEventListener(
        "touchstart",
        (e: TouchEvent) => {
          touchStartX = e.touches[0].clientX;
        },
        { passive: true }
      );

      viewport.addEventListener(
        "touchend",
        (e: TouchEvent) => {
          const touchEndX = e.changedTouches[0].clientX;
          const diffX = touchEndX - touchStartX;
          if (Math.abs(diffX) > 40) {
            if (diffX < 0) {
              const next = (currentIndex + 1) % slides.length;
              goToSlide(next, 1);
            } else {
              const prev = (currentIndex - 1 + slides.length) % slides.length;
              goToSlide(prev, -1);
            }
          }
        },
        { passive: true }
      );

      // Teclas ← y →
      carousel.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          const prev = (currentIndex - 1 + slides.length) % slides.length;
          goToSlide(prev, -1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          const next = (currentIndex + 1) % slides.length;
          goToSlide(next, 1);
        }
      });
    });
  }

  // Inicialización limpia
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCarousels);
  } else {
    setupCarousels();
  }
</script>

<style is:global>
  /* === ESTILOS GLOBALES DE LA GALERÍA Y CARRUSEL === */
  .gallery {
    display: grid;
    gap: 12px;
    width: 100%;
  }

  .gallery.gallery--hero {
    display: block;
  }

  #galeria .section-container,
  .gallery-hero-carousel {
    position: relative;
    max-width: min(90vw, 1140px);
    margin: 0 auto;
    width: 100%;
    outline: none;
  }

  .carousel-viewport {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    min-height: 460px;
    max-height: 640px;
    height: auto;
    overflow: hidden;
    border-radius: 16px;
    background: #0e0e0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    transform-style: preserve-3d;
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }

  .gallery-hero-carousel:hover .carousel-viewport {
    border-color: rgba(255, 107, 0, 0.22);
    box-shadow: 0 10px 32px rgba(0, 0, 0, 0.5), 0 0 18px rgba(255, 107, 0, 0.08);
  }

  .carousel-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 16px;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    cursor: pointer;
    overflow: hidden;
    box-sizing: border-box;
    will-change: opacity;
  }

  .carousel-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .carousel-slide .gallery-media {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 10px;
  }

  .carousel-slide .gallery-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .carousel-slide .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.15) 60%,
      rgba(0, 0, 0, 0) 100%
    );
    pointer-events: none;
  }

  .carousel-slide .hero-caption-inline {
    position: absolute;
    left: 20px;
    bottom: 16px;
    color: #fff;
    font-weight: 700;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    margin: 0;
    font-size: 1rem;
    z-index: 5;
    pointer-events: none;
  }

  /* Botones de navegación (Flechas izquierda / derecha) */
  .carousel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(14, 14, 14, 0.75);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
  }

  .carousel-btn:hover {
    background: rgba(255, 107, 0, 0.25);
    border-color: #ff6b00;
    color: #ff8c33;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 0 24px rgba(255, 107, 0, 0.5);
  }

  .carousel-btn:active {
    transform: translateY(-50%) scale(0.95);
  }

  .carousel-btn--prev {
    left: 20px;
  }

  .carousel-btn--next {
    right: 20px;
  }

  /* Indicadores / Dots inferiores */
  .carousel-indicators {
    position: absolute;
    bottom: 24px;
    right: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
    z-index: 10;
  }

  .carousel-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    padding: 0;
    outline: none;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.7);
  }

  .carousel-dot.active {
    width: 32px;
    border-radius: 99px;
    background: #ff6b00;
    box-shadow: 0 0 14px rgba(255, 107, 0, 0.7);
  }

  /* Adaptación Responsive */
  @media (max-width: 768px) {
    .carousel-viewport {
      aspect-ratio: 16 / 10;
      min-height: clamp(340px, 50vh, 440px);
      max-height: 480px;
      height: auto;
    }

    .carousel-btn {
      width: 42px;
      height: 42px;
    }

    .carousel-btn--prev {
      left: 10px;
    }

    .carousel-btn--next {
      right: 10px;
    }

    .carousel-indicators {
      bottom: 16px;
      right: 18px;
    }
  }

  /* === GRID MOSAICO TRADICIONAL === */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 6), minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 1024px) {
    .gallery-grid {
      --columns: 4;
    }
  }
  @media (max-width: 768px) {
    .gallery-grid {
      --columns: 2;
    }
  }
  @media (max-width: 480px) {
    .gallery-grid {
      --columns: 1;
    }
  }

  /* === LIGHTBOX === */
  lightbox-island {
    display: contents;
  }

  html.lb-open,
  body.lb-open {
    overflow: hidden;
  }
</style>
