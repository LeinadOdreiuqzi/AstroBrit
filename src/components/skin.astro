---
import type { MemberSkin } from "../types";
import { resolveSkinUrl, normalizeRank } from "../data/skinsData.ts";

interface Props {
  skinsToDisplay: MemberSkin[];
  interactive?: boolean;
  width?: number;
  height?: number;
}

const {
  skinsToDisplay = [],
  interactive = false,
  width = 200,
  height = 300,
} = Astro.props;
const containerId = `skin-container-${Math.random().toString(36).slice(2, 11)}`;
---

<div id={containerId} class="skin-viewers-container">
  {
    skinsToDisplay.map((skin) => {
      const resolvedConfig = {
        ...skin,
        skinPath: resolveSkinUrl(skin),
      };
      return (
        <div
          class="skin-item"
          data-skin-config={JSON.stringify(resolvedConfig)}
          data-rank={normalizeRank(skin.rankTitle)}
        >
          <canvas id={skin.id} style="pointer-events: none;" />
        </div>
      );
    })
  }
</div>

<script
  define:vars={{ skinsToDisplay, containerId, interactive, width, height }}
>
  // @ts-nocheck
  const cId = containerId;
  const viewers = new Map();

  const getSkinview = () => {
    return new Promise((resolve) => {
      // @ts-ignore
      if (window.skinview3d) return resolve(window.skinview3d);
      const interval = setInterval(() => {
        // @ts-ignore
        if (window.skinview3d) {
          clearInterval(interval);
          // @ts-ignore
          resolve(window.skinview3d);
        }
      }, 25);
      setTimeout(() => {
        clearInterval(interval);
        // @ts-ignore
        resolve(window.skinview3d || null);
      }, 5000);
    });
  };

  const initViewer = async (skinConfig) => {
    const sv = await getSkinview();
    if (!sv) return null;

    const canvasElement = document.getElementById(skinConfig.id);
    if (!canvasElement) return null;

    let skinViewer;
    try {
      skinViewer = new sv.SkinViewer({
        canvas: canvasElement,
        width: width,
        height: height,
      });

      // Explicitly load skin and catch every possible error
      const skinUrl =
        skinConfig.skinPath ||
        (skinConfig.username
          ? `https://mineskin.eu/skin/${encodeURIComponent(skinConfig.username)}`
          : "/assets/servi.webp");
      skinViewer.loadSkin(skinUrl).catch((e) => {
        console.error("Grid skin load failed:", e);
      });
    } catch (e) {
      console.error("Failed to create SkinViewer:", e);
      return null;
    }

    if (
      skinConfig.animation &&
      typeof sv[skinConfig.animation] === "function"
    ) {
      skinViewer.animation = new sv[skinConfig.animation]();
    } else {
      skinViewer.animation = new sv.IdleAnimation();
    }

    skinViewer.autoRotate =
      skinConfig.autoRotate !== undefined ? skinConfig.autoRotate : true;
    skinViewer.cameraLight.intensity = skinConfig.cameraLightIntensity ?? 1.9;
    skinViewer.globalLight.intensity = skinConfig.globalLightIntensity ?? 2.4;

    skinViewer.camera.position.set(
      skinConfig.cameraPositionX ?? 0,
      skinConfig.cameraPositionY ?? 15,
      skinConfig.cameraPositionZ ?? 60,
    );

    skinViewer.camera.lookAt(
      skinConfig.cameraLookAtX ?? 0,
      skinConfig.cameraLookAtY ?? 10,
      skinConfig.cameraLookAtZ ?? 0,
    );

    return skinViewer;
  };

  // Intersection Observer con pausa de render loop para 0% GPU en elementos ocultos
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const id = entry.target.id;
        const parent = entry.target.parentElement;
        if (!parent) return;
        const configAttr = parent.getAttribute("data-skin-config");
        if (!configAttr) return;
        const config = JSON.parse(configAttr);

        if (entry.isIntersecting) {
          if (!viewers.has(id)) {
            viewers.set(id, "loading");
            initViewer(config).then((viewer) => {
              if (viewer) {
                viewers.set(id, viewer);
              } else {
                viewers.delete(id);
              }
            });
          } else {
            const viewer = viewers.get(id);
            if (viewer && typeof viewer !== "string" && viewer.renderPaused) {
              viewer.renderPaused = false;
            }
          }
        } else {
          // Pausar render loop al salir de pantalla
          if (viewers.has(id)) {
            const viewer = viewers.get(id);
            if (viewer && typeof viewer !== "string" && !viewer.renderPaused) {
              viewer.renderPaused = true;
            }
          }
        }
      });
    },
    { rootMargin: "150px" },
  );

  // Start observing
  skinsToDisplay.forEach((skinConfig) => {
    const canvasElement = document.getElementById(skinConfig.id);
    if (canvasElement) observer.observe(canvasElement);
  });

  // Handle clicks - Scoped to this container only
  const container = document.getElementById(cId);
  if (container && interactive) {
    const skinItems = container.querySelectorAll(".skin-item");
    skinItems.forEach((item) => {
      item.addEventListener("click", (e) => {
        e.stopPropagation();

        try {
          const config = JSON.parse(item.getAttribute("data-skin-config"));
          const lightbox = document.getElementById("global-lightbox");

          if (lightbox) {
            const itemData = {
              id: config.id,
              src:
                config.skinPath ||
                (config.username
                  ? `https://mineskin.eu/skin/${encodeURIComponent(config.username)}`
                  : "/assets/servi.webp"),
              title: "Guardian",
              subtitle: "Destiny View",
              ...config,
            };

            if (typeof lightbox.setData === "function") {
              lightbox.setData({
                mode: "destiny",
                items: [itemData],
              });
            } else {
              lightbox.setAttribute("mode", "destiny");
              lightbox.setAttribute("items", JSON.stringify([itemData]));
            }

            if (typeof lightbox.open === "function") {
              lightbox.open();
            } else {
              lightbox.setAttribute("open", "");
            }
          }
        } catch (e) {
          console.error("Error opening skin lightbox:", e);
        }
      });
    });
  }
</script>

<style>
  .skin-viewers-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
    width: 100%;
  }
  .skin-item {
    cursor: pointer;
    transition:
      transform 0.2s ease,
      filter 0.2s ease;
  }
  .skin-item:hover {
    transform: scale(1.05);
    filter: drop-shadow(0 0 8px rgba(255, 107, 0, 0.4));
  }
</style>
