---
import Section from "./common/Section.astro";
import Skin from "./skin.astro";
import { memberSkins } from "../data/skinsData.ts";
---

<Section
  id="trayectoria"
  title="Trayectoria Britannica"
  subtitle="Explora los perfiles y logros de nuestros miembros destacados."
  variant="gradient"
  divider={true}
>
  <div class="skins-grid">
    <Skin skinsToDisplay={memberSkins} interactive={true} />
  </div>
</Section>

<script>
  // Client-side randomization
  document.addEventListener("DOMContentLoaded", () => {
    const grid = document.querySelector(
      ".skins-grid .skin-viewers-container",
    );
    if (grid) {
      const items = Array.from(grid.children);
      items.sort(() => Math.random() - 0.5);
      items.forEach((item) => grid.appendChild(item));
    }
  });
</script>

<style>
  .skins-grid {
    display: flex;
    justify-content: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }
</style>
