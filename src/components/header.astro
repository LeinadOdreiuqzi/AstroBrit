---
const title = "BRITANNIA";
const letters = title.split("");
---

<header class="header" role="banner">
    <div class="contenedor">
        <a href="/" class="texto" aria-label="Britannia - Inicio">
            {
                letters.map((letra, i) => (
                    <span style={`--i: ${i};`}>{letra}</span>
                ))
            }
        </a>
    </div>
</header>

<style>
    .texto {
        display: inline-flex;
        font-family: "Arial", sans-serif;
        font-size: clamp(1.4rem, 3.5vw, 2.2rem);
        font-weight: 900;
        letter-spacing: 4px;
        text-decoration: none;
        user-select: none;
    }

    .texto span {
        color: #555;
        animation: letterGlow 4.5s ease-in-out infinite;
        animation-delay: calc(var(--i) * 0.5s);
        display: inline-block;
        transition: transform 0.2s ease;
    }

    .texto:hover span {
        animation-play-state: paused;
        color: #ff6b00;
        text-shadow: 0 0 16px rgba(255, 107, 0, 0.8);
    }

    @keyframes letterGlow {
        0%,
        100% {
            color: #555;
            text-shadow: none;
        }
        20% {
            color: #d16a16;
            text-shadow: 0 0 14px rgba(209, 106, 22, 0.8);
        }
        40% {
            color: #555;
            text-shadow: none;
        }
    }
</style>
