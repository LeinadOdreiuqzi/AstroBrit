---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  badge?: string;
  variant?: "default" | "dark" | "gradient" | "plain";
  divider?: boolean;
  align?: "center" | "left";
  class?: string;
}

const {
  id,
  title,
  subtitle,
  badge,
  variant = "default",
  divider = true,
  align = "center",
  class: extraClass = "",
} = Astro.props;
---

<section
  id={id}
  class={`modular-section variant-${variant} ${divider ? "has-divider" : ""} ${extraClass}`}
>
  <div class="section-container">
    {
      (badge || title || subtitle || Astro.slots.has("header")) && (
        <header class={`section-header align-${align}`}>
          {badge && <span class="section-badge">{badge}</span>}
          {title && <h2 class="section-title">{title}</h2>}
          {subtitle && <p class="section-subtitle">{subtitle}</p>}
          <slot name="header" />
        </header>
      )
    }

    <div class="section-content">
      <slot />
    </div>
  </div>
</section>

<style>
  .modular-section {
    position: relative;
    width: 100%;
    padding: var(--space-xl) var(--section-padding-x);
    transition: background-color 0.3s ease;
  }

  /* Variantes de Fondo */
  .variant-default {
    background-color: var(--color-bg);
  }

  .variant-dark {
    background-color: var(--color-bg-dark);
  }

  .variant-gradient {
    background: linear-gradient(
      to bottom,
      var(--color-bg-dark),
      var(--color-bg)
    );
  }

  .variant-plain {
    background: transparent;
  }

  /* Línea divisoria superior con degradado sutil */
  .has-divider::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.12),
      transparent
    );
    pointer-events: none;
  }

  .section-container {
    max-width: var(--section-max-width, 1200px);
    margin: 0 auto;
    width: 100%;
  }

  /* Encabezados de Sección */
  .section-header {
    margin-bottom: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .section-header.align-center {
    align-items: center;
    text-align: center;
  }

  .section-header.align-left {
    align-items: flex-start;
    text-align: left;
  }

  /* Badge de Sección */
  .section-badge {
    display: inline-block;
    background: rgba(255, 107, 0, 0.15);
    color: #ff8c33;
    border: 1px solid rgba(255, 107, 0, 0.35);
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    box-shadow: 0 0 20px rgba(255, 107, 0, 0.2);
    margin-bottom: var(--space-xs);
  }

  /* Título con Degradado Oficial de Britannia */
  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 2px;
    line-height: 1.15;
    margin: 0;
    background: linear-gradient(45deg, #ff6b00, #ff8c33);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Subtítulo */
  .section-subtitle {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
    margin: 0;
    max-width: 650px;
  }

  .section-content {
    position: relative;
    width: 100%;
  }

  @media (max-width: 768px) {
    .modular-section {
      padding: var(--space-lg) var(--section-padding-x);
    }

    .section-header {
      margin-bottom: var(--space-lg);
    }
  }
</style>
