---
import Footer from "../components/Footer.astro";
---

<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/png"
			href="/assets/Theeye.png?v=2"
			sizes="32x32"
		/>
		<link rel="shortcut icon" href="/assets/Theeye.png?v=2" />
		<link rel="apple-touch-icon" href="/assets/Theeye.png?v=2" />

		<!-- SEO Meta Tags -->
		<title>BritanniaMC - Comunidad de Minecraft Towny</title>
		<meta
			name="description"
			content="BritanniaMC: Comunidad de Minecraft Towny, descubre nuestra historia, proyectos y construcciones."
		/>
		<meta
			name="keywords"
			content="Minecraft, BritanniaMC, Cococraft, Comunidad Minecraft, Servidor Minecraft, Construcción Minecraft, Minecraft Towny, Towny"
		/>
		<meta name="author" content="BritanniaMC Team" />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href="https://britanniamc.com/" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://britanniamc.com/" />
		<meta property="og:site_name" content="BritanniaMC" />
		<meta property="og:locale" content="es_ES" />
		<meta
			property="og:title"
			content="BritanniaMC - Comunidad de Minecraft Towny"
		/>
		<meta
			property="og:description"
			content="Explora Britannia en Cococraft: Galería de construcciones, miembros destacados y proyectos masivos."
		/>
		<meta property="og:image" content="https://britanniamc.com/assets/Theeye.png" />
		<meta property="og:image:secure_url" content="https://britanniamc.com/assets/Theeye.png" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="660" />
		<meta property="og:image:height" content="669" />
		<meta property="og:image:alt" content="Logo oficial de BritanniaMC" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content="https://britanniamc.com/" />
		<meta
			name="twitter:title"
			content="BritanniaMC - Comunidad de Minecraft Towny"
		/>
		<meta
			name="twitter:description"
			content="BritanniaMC: Comunidad de Minecraft Towny, descubre nuestra historia, proyectos y construcciones."
		/>
		<meta name="twitter:image" content="https://britanniamc.com/assets/Theeye.png" />
		<meta name="twitter:image:alt" content="Logo oficial de BritanniaMC" />

		<!-- JSON-LD Structured Data for Rich Search Results -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				"name": "BritanniaMC",
				"url": "https://britanniamc.com/",
				"description": "Comunidad de Minecraft Towny en Cococraft. Historia, proyectos masivos y miembros destacados.",
				"image": "https://britanniamc.com/assets/Theeye.png",
				"inLanguage": "es"
			}
		</script>

		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="/assets/styles.css" />
		<!-- Local Bundles -->
		<script>
			import "../scripts/gsap.js";
			import "../scripts/skinview.ts";
		</script>
	</head>
	<body>
		<slot />
		<Footer />

		<!-- Global Lightbox -->
		<lightbox-island id="global-lightbox"></lightbox-island>
		<script>
			import "../components/LightboxIsland.js";
		</script>
	</body>
</html>
